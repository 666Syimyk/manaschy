{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["../src/*"],
      "@/assets/*": ["../assets/*"]
    },
    "baseUrl": ".."
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
